<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.muelle.autohide-mode">
    <value nick="on" value="0"/>
    <value nick="intelligent" value="1"/>
    <value nick="off" value="2"/>
  </enum>

  <schema id="org.gnome.shell.extensions.muelle"
          path="/org/gnome/shell/extensions/muelle/">
    <key name="show-trash" type="b">
      <default>true</default>
      <summary>Show Trash</summary>
      <description>
        Show a Trash item at the end of the dock.
      </description>
    </key>

    <key name="dock-icon-size" type="i">
      <default>64</default>
      <range min="8" max="128"/>
      <summary>Dock icon size</summary>
      <description>
        Icon size in pixels. Defaults to the native Dash size of 64 px.
      </description>
    </key>

    <key name="autohide-mode"
         enum="org.gnome.shell.extensions.muelle.autohide-mode">
      <default>'intelligent'</default>
      <summary>Auto-hide behavior</summary>
      <description>
        on: always hidden, revealed by hovering the bottom edge.
        intelligent: hidden only when a window overlaps the dock.
        off: always visible.
      </description>
    </key>
  </schema>
</schemalist>
